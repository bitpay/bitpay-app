+/**
+ * Lazy package: React Native creates these modules on first JS access instead
+ * of at startup. With the eager ReactPackage form, bridgeless RN built both
+ * modules while the React host started, so every launch loaded VisionCamera's
+ * native library and started ProcessCameraProvider + ExtensionsManager, even
+ * though only the Scan screen uses the camera.
+ */
+class CameraPackage : BaseReactPackage() {
+  override fun getModule(name: String, reactContext: ReactApplicationContext): NativeModule? =
+    when (name) {
+      CAMERA_VIEW -> CameraViewModule(reactContext)
+      CAMERA_DEVICES -> CameraDevicesManager(reactContext)
+      else -> null
+    }
+
+  override fun getReactModuleInfoProvider(): ReactModuleInfoProvider =
+    ReactModuleInfoProvider {
+      mapOf(
+        CAMERA_VIEW to ReactModuleInfo(CAMERA_VIEW, CameraViewModule::class.java.name, false, false, false, false),
+        CAMERA_DEVICES to ReactModuleInfo(CAMERA_DEVICES, CameraDevicesManager::class.java.name, false, false, false, false)
+      )
+    }
 
   override fun createViewManagers(reactContext: ReactApplicationContext): List<ViewManager<*, *>> = listOf(CameraViewManager())
+
+  private companion object {
+    const val CAMERA_VIEW = "CameraView"
+    const val CAMERA_DEVICES = "CameraDevices"
+  }
 }
