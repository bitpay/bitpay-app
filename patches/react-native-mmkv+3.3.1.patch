new file mode 100644
--- /dev/null
+++ b/node_modules/react-native-mmkv/cpp/LegacyInstanceGuard.h
@@ -0,0 +1,21 @@
+#pragma once
+#include <atomic>
+
+namespace facebook::react {
+// Process lifetime, shared across TurboModule/React-context recreation.
+// A failed constructor also counts as access: never infer that it unmapped.
+class LegacyInstanceGuard {
+  enum State { unseen, opened, sealed };
+  std::atomic<State> state{unseen};
+public:
+  bool open() {
+    State expected = unseen;
+    return state.compare_exchange_strong(expected, opened) || expected == opened;
+  }
+  bool claimRetirement() {
+    State expected = unseen;
+    return state.compare_exchange_strong(expected, sealed) || expected == sealed;
+  }
+};
+inline LegacyInstanceGuard legacyInstanceGuard;
+} // namespace facebook::react
